rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    function isAdminOrAbove() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isSuperAdmin()
      );
    }

    function isAgent() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/agents/$(request.auth.uid));
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─── Role Collections ─────────────────────────────────────────────────────

    match /super_admins/{uid} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdminOrAbove();
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // Agents can read/update their own profile; admins can manage all
    match /agents/{uid} {
      allow read: if isOwner(uid) || isAdminOrAbove();
      allow create: if isAuthenticated(); // self-registration on signup
      allow update: if isOwner(uid) || isAdminOrAbove();
      allow delete: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    // ─── Feature Permissions ──────────────────────────────────────────────────

    // Agents read their own permissions; only admins/superadmins write
    match /agentPermissions/{uid} {
      allow read: if isOwner(uid) || isAdminOrAbove();
      allow write: if isAdminOrAbove();
    }

    // ─── Leads ───────────────────────────────────────────────────────────────

    // Public enquiry form can create leads (no auth required)
    // Agents can only read/update leads assigned to them
    match /leads/{leadId} {
      allow create: if true;
      allow read: if isAuthenticated() && (
        resource.data.agentId == request.auth.uid || isAdminOrAbove()
      );
      allow update: if isAuthenticated() && (
        resource.data.agentId == request.auth.uid || isAdminOrAbove()
      );
      allow delete: if isAdminOrAbove();
    }

    // ─── Catalog Data (read-only for agents, managed by admins) ──────────────

    match /locations/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrAbove();
    }

    match /hotels/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrAbove();
    }

    match /activities/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrAbove();
    }

    match /transport/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrAbove();

      match /packages/{packageId} {
        allow read: if isAuthenticated();
        allow write: if isAdminOrAbove();
      }
    }

    // ─── Quotations ───────────────────────────────────────────────────────────

    // Agents own their quotations; admins can read all
    match /saved_packages_by_agents/{agentId}/packages/{packageId} {
      allow read, write: if isOwner(agentId) || isAdminOrAbove();
    }

    // ─── Public Quotation Tokens ──────────────────────────────────────────────

    // Token-based public access — read only, no auth required for previewing
    match /quotation_tokens/{token} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ─── Deny All Else ────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
