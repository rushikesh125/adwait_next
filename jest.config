// jest.config.cjs
// Babel config is defined INLINE here so Next.js never sees a babel.config file
// and doesn't choke on it during builds.
module.exports = {
  testEnvironment: "node",

  transform: {
    "^.+\\.(js|jsx)$": [
      "babel-jest",
      {
        // Inline Babel config — no babel.config.js / .cjs / .babelrc needed
        presets: [
          [
            "@babel/preset-env",
            {
              targets: { node: "current" },
              modules: "commonjs",
            },
          ],
        ],
      },
    ],
  },

  transformIgnorePatterns: ["/node_modules/"],

  moduleNameMapper: {
    "^@/(.*)$": "<rootDir>/src/$1",
  },

  roots: ["<rootDir>/src"],

  testMatch: [
    "**/__tests__/**/*.[jt]s?(x)",
    "**/?(*.)+(spec|test).[jt]s?(x)",
  ],
};
